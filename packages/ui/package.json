{
  "name": "@prismwave/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Accessible React components, design tokens, and layouts built with Tailwind CSS.",
  "license": "MIT",
  "author": "PrismWave Studio",
  "homepage": "https://github.com/YoichiDev-tech/prismwave-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoichiDev-tech/prismwave-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/YoichiDev-tech/prismwave-ui/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "tailwindcss",
    "ui",
    "components",
    "design-system",
    "design-tokens",
    "accessible"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "vite-plugin-dts": "^4.5.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
